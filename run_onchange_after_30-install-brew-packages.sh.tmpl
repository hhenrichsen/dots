{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/bash
set -uo pipefail

failures_log="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/setup-failures.log"
note_failure() {
    mkdir -p "${failures_log%/*}"
    printf '%s\n' "$1" >>"$failures_log"
    printf 'WARN: %s (continuing)\n' "$1" >&2
}

if command -v brew >/dev/null 2>&1; then
    brew_bin="$(command -v brew)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
    brew_bin=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
    brew_bin=/usr/local/bin/brew
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    brew_bin=/home/linuxbrew/.linuxbrew/bin/brew
else
    note_failure "brew packages: Homebrew is not available"
    exit 0
fi

"$brew_bin" bundle --file=/dev/stdin <<'BREWFILE' || note_failure "brew bundle: some formulae failed"
{{- range .packages.brew }}
brew {{ . | quote }}
{{- end }}
BREWFILE
exit 0
{{- end }}
