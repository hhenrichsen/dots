{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/sh
set -u

failures_log="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/setup-failures.log"
note_failure() {
    mkdir -p "${failures_log%/*}"
    printf '%s\n' "$1" >>"$failures_log"
    printf 'WARN: %s (continuing)\n' "$1" >&2
}

# fish_plugins: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
if ! command -v fish >/dev/null 2>&1; then
    for candidate in /opt/homebrew/bin/fish /usr/local/bin/fish /home/linuxbrew/.linuxbrew/bin/fish; do
        if [ -x "$candidate" ]; then
            fish_bin="$candidate"
            break
        fi
    done
else
    fish_bin="$(command -v fish)"
fi

if [ -z "${fish_bin:-}" ]; then
    note_failure "fisher plugins: fish is not available"
    exit 0
fi

if ! "$fish_bin" -c 'type -q fisher'; then
    curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish \
        | "$fish_bin" -c 'source; fisher install jorgebucaran/fisher' \
        || note_failure "fisher plugins: fisher bootstrap failed"
fi

"$fish_bin" -c 'fisher update' || note_failure "fisher plugins: fisher update failed"
exit 0
{{- end }}
