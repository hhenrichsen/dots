{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/sh
set -eu

# fish_plugins: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
if ! command -v fish >/dev/null 2>&1; then
    for candidate in /opt/homebrew/bin/fish /usr/local/bin/fish /home/linuxbrew/.linuxbrew/bin/fish; do
        if [ -x "$candidate" ]; then
            fish_bin="$candidate"
            break
        fi
    done
else
    fish_bin="$(command -v fish)"
fi

if [ -z "${fish_bin:-}" ]; then
    echo "fish was not found after package installation." >&2
    exit 1
fi

if ! "$fish_bin" -c 'type -q fisher'; then
    curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish \
        | "$fish_bin" -c 'source; fisher install jorgebucaran/fisher'
fi

"$fish_bin" -c 'fisher update'
{{- end }}
