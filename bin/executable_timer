#!/usr/bin/env python3
import re
import subprocess
import sys
import time


def parse_duration(s):
    """Parse a duration string like '5m', '30s', '500ms', '2h' or '90' (seconds)."""
    s = s.strip().lower()
    
    match = re.fullmatch(r'(\d+(?:\.\d+)?)\s*(ms|s|m|h)?', s)
    if not match:
        print(f"Invalid duration: {s}", file=sys.stderr)
        sys.exit(1)
    
    value = float(match.group(1))
    unit = match.group(2) or 's'
    
    multipliers = {'ms': 0.001, 's': 1, 'm': 60, 'h': 3600}
    return value * multipliers[unit]


if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: timer <duration>", file=sys.stderr)
        print("Examples: timer 30s, timer 5m, timer 500ms, timer 2h", file=sys.stderr)
        sys.exit(1)
    
    duration_str = sys.argv[1]
    seconds = parse_duration(duration_str)
    
    time.sleep(seconds)
    subprocess.run(['sfx', 'ringaling'])
    subprocess.run(['notify', 'Timer complete', duration_str])
