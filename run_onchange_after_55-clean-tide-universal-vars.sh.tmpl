{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/sh
set -eu

# tide config: {{ include "dot_config/fish/conf.d/00_tide_config.fish" | sha256sum }}
if command -v fish >/dev/null 2>&1; then
    fish_bin="$(command -v fish)"
else
    for candidate in /opt/homebrew/bin/fish /usr/local/bin/fish /home/linuxbrew/.linuxbrew/bin/fish; do
        if [ -x "$candidate" ]; then
            fish_bin="$candidate"
            break
        fi
    done
fi

if [ -z "${fish_bin:-}" ]; then
    echo "fish was not found after package installation." >&2
    exit 1
fi

"$fish_bin" -c '
    for name in (set --names | string match "tide_*")
        if set --query --universal $name
            set --erase --universal $name
        end
    end
'
{{- end }}
