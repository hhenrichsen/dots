{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/sh
set -u

failures_log="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/setup-failures.log"
note_failure() {
    mkdir -p "${failures_log%/*}"
    printf '%s\n' "$1" >>"$failures_log"
    printf 'WARN: %s (continuing)\n' "$1" >&2
}

# tide config: {{ include "dot_config/fish/conf.d/00_tide_config.fish" | sha256sum }}
if command -v fish >/dev/null 2>&1; then
    fish_bin="$(command -v fish)"
else
    for candidate in /opt/homebrew/bin/fish /usr/local/bin/fish /home/linuxbrew/.linuxbrew/bin/fish; do
        if [ -x "$candidate" ]; then
            fish_bin="$candidate"
            break
        fi
    done
fi

if [ -z "${fish_bin:-}" ]; then
    note_failure "tide cleanup: fish is not available"
    exit 0
fi

"$fish_bin" -c '
    for name in (set --names | string match "tide_*")
        if set --query --universal $name
            set --erase --universal $name
        end
    end
' || note_failure "tide cleanup: fish -c cleanup failed"
exit 0
{{- end }}
