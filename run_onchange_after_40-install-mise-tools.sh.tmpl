{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/sh
set -u

failures_log="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/setup-failures.log"
note_failure() {
    mkdir -p "${failures_log%/*}"
    printf '%s\n' "$1" >>"$failures_log"
    printf 'WARN: %s (continuing)\n' "$1" >&2
}

mise_bin="$HOME/.local/bin/mise"
if [ ! -x "$mise_bin" ]; then
    mise_bin="$(command -v mise)"
fi
if [ -z "$mise_bin" ]; then
    note_failure "mise tools: mise is not installed"
    exit 0
fi

try_tool() { "$mise_bin" install "$1" || note_failure "mise install $1"; }
{{ range $tool, $version := .packages.mise }}try_tool {{ printf "%s@%s" $tool $version | quote }}
{{ end }}{{ range .packages.npm }}try_tool {{ printf "npm:%s" . | quote }}
{{ end }}
exit 0
{{- end }}
