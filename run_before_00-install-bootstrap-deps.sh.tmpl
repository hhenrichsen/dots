{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -u

failures_log="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/setup-failures.log"
note_failure() {
    mkdir -p "${failures_log%/*}"
    printf '%s\n' "$1" >>"$failures_log"
    printf 'WARN: %s (continuing)\n' "$1" >&2
}

if command -v apt-get >/dev/null 2>&1; then
    missing=""
{{- range .packages.bootstrap.debian }}
    if ! dpkg-query -W -f='${Status}' {{ . | quote }} 2>/dev/null | grep -q 'install ok installed'; then
        missing="$missing {{ . }}"
    fi
{{- end }}
    if [ -n "$missing" ]; then
        # shellcheck disable=SC2086
        { sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y $missing; } \
            || note_failure "bootstrap packages (apt-get/dnf/pacman)"
    fi
elif command -v dnf >/dev/null 2>&1; then
    missing=""
{{- range .packages.bootstrap.fedora }}
    if ! rpm -q {{ . | quote }} >/dev/null 2>&1; then
        missing="$missing {{ . }}"
    fi
{{- end }}
    if [ -n "$missing" ]; then
        # shellcheck disable=SC2086
        sudo dnf install -y $missing || note_failure "bootstrap packages (apt-get/dnf/pacman)"
    fi
elif command -v pacman >/dev/null 2>&1; then
    missing=""
{{- range .packages.bootstrap.arch }}
    if ! pacman -Q {{ . | quote }} >/dev/null 2>&1; then
        missing="$missing {{ . }}"
    fi
{{- end }}
    if [ -n "$missing" ]; then
        # shellcheck disable=SC2086
        sudo pacman -S --needed --noconfirm $missing || note_failure "bootstrap packages (apt-get/dnf/pacman)"
    fi
else
    note_failure "bootstrap packages: unsupported Linux package manager; install curl, git, a compiler, and build tools manually"
fi
exit 0
{{- else if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -u

failures_log="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/setup-failures.log"
note_failure() {
    mkdir -p "${failures_log%/*}"
    printf '%s\n' "$1" >>"$failures_log"
    printf 'WARN: %s (continuing)\n' "$1" >&2
}

if ! xcode-select -p >/dev/null 2>&1; then
    note_failure "Xcode Command Line Tools are missing; run 'xcode-select --install'"
fi
exit 0
{{- end }}
