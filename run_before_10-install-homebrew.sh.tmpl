{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/bin/sh
set -u

failures_log="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/setup-failures.log"
note_failure() {
    mkdir -p "${failures_log%/*}"
    printf '%s\n' "$1" >>"$failures_log"
    printf 'WARN: %s (continuing)\n' "$1" >&2
}

if command -v brew >/dev/null 2>&1 \
    || [ -x /opt/homebrew/bin/brew ] \
    || [ -x /usr/local/bin/brew ] \
    || [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    exit 0
fi

NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || { note_failure "Homebrew install"; exit 0; }
{{- end }}
